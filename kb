#!/usr/bin/env bash
# kb —— 多模态知识库命令行入口
#
#   ./kb <命令>        直接用（无需安装，Python 从当前目录找到包）
#   kb <命令>          装了包之后（pip install -e .）
#
# 会自动加载环境变量：先读 ./.env，再读 ./deploy/.env（后者不覆盖已设置的）。
# 这样 Docker 部署后，宿主机侧也能直接跑 kb search / eval / demo。
set -e
cd "$(dirname "$0")"

load_env() {
  [ -f "$1" ] || return 0
  # 逐行解析，已存在的变量不覆盖（-a 导出）
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    key=${line%%=*}; val=${line#*=}
    case "$key" in *[!A-Za-z0-9_]*) continue ;; esac
    # 去掉可能的首尾引号
    val=${val%\"}; val=${val#\"}; val=${val%\'}; val=${val#\'}
    if [ -z "${!key:-}" ]; then export "$key=$val"; fi
  done < "$1"
}

load_env "./.env"
load_env "./deploy/.env"

exec python3 -m multimodal_kb "$@"
