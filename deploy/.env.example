# ============================================================
# 复制成 .env 并按需填写。所有变量都有合理默认值。
#   cp .env.example .env
# ============================================================

# ---- 必填：向量化与图片标注（阿里云百炼）----
# https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 解析：MinerU ----
# 官方 API（推荐）：https://mineru.net/apiManage/token  免费额度 1000 页/天
MINERU_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# api = 走官方 API（约 40 秒/100 页）
# local = 走本地 CPU（约 62 秒/100 页，零成本，需先安装 mineru）
MINERU_MODE=api

# ---- 存储 ----
QDRANT_URL=http://localhost:6333
MMKB_COLLECTION=mmkb

# ---- 目录（默认都在 <项目>/data 下，已在 .gitignore 里）----
# MMKB_WORK_DIR=./data/work
# MMKB_PARSED_DIR=./data/parsed

# ---- 检索服务 ----
MMKB_PORT=8088
# 图片直连前缀。**这是浏览器视角的地址**：
#   本机访问填 http://localhost:8088
#   别的机器访问填 http://<宿主IP>:8088
MMKB_PUBLIC_URL=http://localhost:8088

# ---- 模型（一般不用改）----
# MMKB_FUSION_MODEL=qwen3-vl-embedding
# MMKB_TEXT_MODEL=text-embedding-v4
# MMKB_VISION_MODEL=qwen3-vl-flash
# MMKB_RERANK_MODEL=qwen3-rerank

# ---- 可选：Dify 适配器 ----
# MMKB_ADAPTER_TOKEN=change-me

# ---- Docker 部署专用 ----
QDRANT_PORT=6333
MMKB_PORT=8088
OWUI_PORT=3000
WEBUI_SECRET_KEY=mmkb-change-me
MMKB_TOP_K=5
